{
  "name": "cresco",
  "private": false,
  "version": "0.1.0",
  "description": "A skill-demand radar that tells you what to learn next and where to learn it free.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "collect": "tsx scripts/collect.ts",
    "seed": "tsx scripts/seed.ts",
    "backfill": "tsx scripts/backfill.ts",
    "paths": "tsx scripts/paths.ts",
    "backtest": "tsx scripts/backtest.ts",
    "leading": "tsx scripts/leading.ts",
    "leadlag": "tsx scripts/leadlag.ts",
    "holdout": "tsx scripts/holdout.ts",
    "chart": "tsx scripts/chart.ts",
    "market": "tsx scripts/market.ts",
    "compare": "tsx scripts/compare.ts",
    "edgar": "tsx scripts/edgar.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
