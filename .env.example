# Every key here is OPTIONAL. Cresco runs with none of them —
# it falls back to the zero-key sources (Hacker News, Who's Hiring, Bluesky)
# and to bundled fixtures for the rest. Each key you add upgrades one
# collector from fixture to live.

# YouTube Data API v3 — free, no billing card.
# console.cloud.google.com -> new project -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Adzuna job-postings API — free tier, gives live job counts + salary by keyword.
# developer.adzuna.com -> register -> app id + app key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Reddit is best-effort without credentials (public JSON endpoints, rate limited).
# Set a descriptive user agent to be a good citizen.
REDDIT_USER_AGENT=cresco/0.1 (skill-demand research)

PORT=3000
